{
  "name": "fortune-cookie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fortune Cookie: a daily reading from your Four Pillars birth chart, in plain English.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/verify.ts",
    "build:single": "tsc --noEmit && SINGLE=1 vite build && node scripts/build-single-file.mjs",
    "build:cities": "node scripts/build-cities.mjs"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "astronomia": "^4.2.0",
    "d3-geo": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.0",
    "all-the-cities": "^3.1.0",
    "country-state-city": "^3.2.1",
    "lunar-javascript": "^1.7.7",
    "tsx": "^4.22.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "world-atlas": "^2.0.2"
  }
}
